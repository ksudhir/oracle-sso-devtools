{
  "manifest_version": 3,
  "name": "Enterprise Authentication & NetLog Inspector",
  "version": "5.1",
  "description": "Troubleshoot SAML, OAuth/OIDC, OAM/WebGate, Kerberos/WNA, NTLM, X.509, and Chromium NetLog authentication evidence.",
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open Offline Authentication Viewer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
