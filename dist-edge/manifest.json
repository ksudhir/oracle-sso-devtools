{
  "manifest_version": 3,
  "name": "Enterprise Authentication & NetLog Inspector",
  "version": "5.1.1",
  "description": "Investigate browser authentication failures with live capture, offline analysis, and correlated diagnostic evidence.",
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open Offline Authentication Viewer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
